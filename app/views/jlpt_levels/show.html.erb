<%# show all kanji in a specific jlpt level %>
<section class="jlpt-page">
  <span class="top">
    <%= link_to root_path do %>
      <%= image_tag('arrow-left-square.svg', alt: 'back arrow button', class: 'arrow') %>
    <% end %>
    <h1><%= @kanji_characters.count %> kanji</h1>
  </span>
  <div class="cards-wrapped">
    <% @kanji_characters.each do |kanji| %>
      <%= link_to kanji_character_path(kanji) do %>
        <article class="<%= user_signed_in? && current_user.learnt_kanji?(kanji.id) ? 'gold card' : 'card' %>">
          <h2><%= kanji.kanji %></h2>
        </article>
      <% end %>
    <% end %>
  </div>
</section>
