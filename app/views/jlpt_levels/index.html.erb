<section class="home">
  <h1>Choose your JLPT level</h1>
  <nav class="link-cards">
    <% @levels.each do |level| %>
      <%= link_to jlpt_level_path(level) do %>
        <article class="card">
          <h2>JLPT N<%= level %> </h2>
          <h3><%= @kanji_character_counts[level] %> kanji</h3>
        </article>
      <% end %>
    <% end %>
  </nav>
  <%= link_to "Kanji of the day", kanji_character_path(5), class: "link-button" %>
</section>
