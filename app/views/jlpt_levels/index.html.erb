<%# all jlpt levels page %>
<section class="home">
  <h1>Choose your JLPT level</h1>
  <nav class="cards">
    <% @levels.each do |level| %>
      <%= link_to jlpt_level_path(level) do %>
        <article class="card to-jlpt">
          <h2>JLPT N<%= level %> </h2>
          <div class="info">
            <h3><%= @kanji_character_counts[level] %> kanji</h3>
            <% if user_signed_in? %>
              <h4><%= current_user.learnt_kanji_jlpt_count[level] %> learnt</h4>
            <% end %>
          </div>
        </article>
      <% end %>
    <% end %>
  </nav>
  <div class="buttons row">
    <%= link_to "Today's kanji", kanji_character_path(@random_kanji), class: "gold button" %>
    <%= link_to "Test me", kanji_tests_path, class: "purple button" %>
  </div>
</section>
