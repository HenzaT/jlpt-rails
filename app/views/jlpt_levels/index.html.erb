<%# all jlpt levels page %>
<section class="home">
  <h1>Choose your JLPT level</h1>
  <nav class="cards">
    <% @levels.each do |level| %>
      <%= link_to jlpt_level_path(level) do %>
        <article class="card to-jlpt">
          <h2>JLPT N<%= level %> </h2>
          <div class="info">
            <h3><%= @kanji_character_counts[level] %> kanji</h3>
            <h4><%= @learnt_kanji %> learnt</h4>
          </div>
        </article>
      <% end %>
    <% end %>
  </nav>
  <%= link_to "Kanji of the day", kanji_character_path(@random_kanji), class: "gold button" %>
</section>
