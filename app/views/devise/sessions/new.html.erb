<section class="devise">
  <header>
    <%= image_tag('person-circle.svg', alt: "user icon", class: "large-img") %>
    <h1>Log in</h1>
  </header>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <span class="input-container">
        <%= image_tag('email.svg', alt: "email envelope icon") %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email" %>
      </span>
    </div>

    <div class="field">
      <span class="input-container">
        <%= image_tag('lock.svg', alt: "lock icon") %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••••••••••••••" %>
      </span>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field remember-me">
        <p><%= f.check_box :remember_me %></p>
        <p><%= f.label :remember_me %></p>
      </div>
    <% end %>

    <%= f.submit "Log in", class: " gold button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
