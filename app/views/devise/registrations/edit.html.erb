<section class="devise">
  <h1>Edit <%= resource_name.to_s.humanize %> Details</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <p><%= f.label :firstname %></p>
      <span class="input-container">
        <%= image_tag('user.svg', alt: "user icon") %>
        <%= f.text_field :firstname, autofocus: true, autocomplete: "firstname" %>
      </span>
    </div>

    <div class="field">
      <p><%= f.label :lastname %></p>
      <span class="input-container">
        <%= image_tag('user.svg', alt: "user icon") %>
        <%= f.text_field :lastname, autofocus: true, autocomplete: "lastname" %>
      </span>
    </div>

    <div class="field">
      <p><%= f.label :email %></p>
      <span class="input-container">
        <%= image_tag('email.svg', alt: 'email envelope icon') %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </span>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>

    <div class="field">
      <p>Change <%= f.label :password %></p>
      <span class="input-container">
        <%= image_tag('unlock.svg', alt: 'unlocked icon') %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••••••••••••••" %>
      </span>
      <% if @minimum_password_length %>
        <p><em><%= @minimum_password_length %> characters minimum</em></p>
      <% end %>
    </div>

    <div class="field">
      <p><%= f.label :password_confirmation %></p>
      <span class="input-container">
        <%= image_tag('unlock.svg', alt: 'unlocked icon') %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••••••••••••••" %>
      </span>
    </div>

    <div class="field">
      <p><%= f.label :current_password %> <i>(we need your current password to confirm your changes)</i></p>
      <span class="input-container">
        <%= image_tag('lock.svg', alt: 'lock icon') %>
        <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••••••••••••••" %>
      </span>
    </div>

    <%= f.submit "Update", class: "gold button" %>
  <% end %>

  <%= button_to "Delete Account", registration_path(resource_name), class: "danger button", data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %>

  <%= link_to "Back", :back %>
</section>
