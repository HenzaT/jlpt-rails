<section class="devise">
  <h1>Sign up</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <span class="input-container">
        <%= image_tag('user.svg', alt: "user icon") %>
        <%= f.text_field :firstname, autofocus: true, autocomplete: "firstname", placeholder: "First Name" %>
      </span>
    </div>

    <div class="field">
      <span class="input-container">
        <%= image_tag('user.svg', alt: "user icon") %>
        <%= f.text_field :lastname, autofocus: true, autocomplete: "lastname", placeholder: "Last Name" %>
      </span>
    </div>

    <div class="field">
      <span class="input-container">
        <%= image_tag('email.svg', alt: "email envelope icon") %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email" %>
      </span>
    </div>

    <div class="field">
      <span class="input-container">
        <%= image_tag('lock.svg', alt: "lock icon") %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••••••••••••••" %>
      </span>
    </div>

    <div class="field">
      <p><%= f.label :password_confirmation %></p>
      <span class="input-container">
        <%= image_tag('lock.svg', alt: "lock icon") %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </span>
    </div>

    <%= f.submit "Sign up", class: "gold button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
