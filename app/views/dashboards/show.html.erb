<%# user dashboard %>
<section class="dashboard">
  <p>Hello</p>
  <h1><%= current_user.firstname %></h1>
  <div class="cards">
    <article class="gold card">
      <p><%= @learnt_kanjis %></p>
      <p>Kanji learnt</p>
    </article>
    <article class="card">
      <p><%= @not_learnt_kanjis %></p>
      <p>Kanji to learn</p>
    </article>
  </div>
  <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "purple button" %>
</section>
