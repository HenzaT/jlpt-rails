<%# user dashboard %>
<section class="dashboard">
  <p>Hello</p>
  <h1><%= current_user.firstname %></h1>

  <div class="cards">
    <section class="learnt">
      <%= link_to learnt_kanjis_path do %>
        <article class="gold card">
          <div class="learnt-count">
            <p><%= @learnt_count %></p>
            <p>Kanji learnt</p>
          </div>
          <h2><%= @most_recent_learnt %></h2>
        </article>
      <% end %>
      <ul class="learnt-groups">
        <% @levels.each do |level| %>
          <li>N<%= level %> - <%= @counts[level] %></li>
        <% end %>
      </ul>
    </section>

    <section class="not-learnt">
      <%= link_to root_path do %>
        <article class="card">
          <p><%= @not_learnt_count %></p>
          <p>Kanji to learn</p>
        </article>
      <% end %>
      <ul class="not-learnt-groups">
        <% @levels.each do |level| %>
          <li>N<%= level %> - <%= @kanji_character_counts[level] - @counts[level] %></li>
        <% end %>
      </ul>
    </section>
    <%= link_to "Edit user details", edit_user_registration_path %>
  </div>
  <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "purple button logout" %>
</section>
