<%# show individual kanji or random kanji %>
<section class="show-kanji" data-controller="show">
  <%= render 'shared/individual_kanji_card', kanji: @kanji %>
  <div class="buttons column">
    <% if user_signed_in? %>
      <% if current_user.learnt_kanji?(@kanji.id) %>
        <%= button_to "Mark as not learnt", kanji_character_learnt_kanjis_path(@kanji), method: :delete, class: "purple button" %>
      <% else %>
        <%= button_to "I've learnt this kanji!", kanji_character_learnt_kanjis_path(@kanji), method: :post, class: "gold button" %>
      <% end %>
    <% end %>
    <%= link_to "back to all kanji", :back, class: "light button" %>
  </div>
</section>
