<section class="random-kanji">
  <article class="card kanji">
    <div class="card-top">
      <h1><%= @random_kanji.kanji %></h1>
      <span class="pill dark">N<%= @random_kanji.jlpt %></span>
    </div>
    <h2><%= @random_kanji.heisig_en %></h2>
    <% if @random_kanji.meanings.size >= 1 %>
      <div class="meanings">
        <div class="meaning-words">
          <% @random_kanji.meanings.first(2).each do |meaning| %>
            <% if meaning != @random_kanji.heisig_en %>
                <h3><%= meaning %></h3>
            <% end %>
          <% end %>
        </div>
        <button type="button" class="pill gold">+<%= @random_kanji.meanings.size %> more</button>
      </div>
    <% end %>
    <hr class="card-separator">
    <% if @random_kanji.kun_readings.size >= 1 %>
      <p>kun readings</p>
      <div class="readings-pills">
        <% @random_kanji.kun_readings.each do |reading| %>
          <span class="pill light"><%= reading %></span>
        <% end %>
      </div>
    <% end %>
    <% if @random_kanji.on_readings.size >= 1 %>
      <p>on readings</p>
      <div class="readings-pills">
        <% @random_kanji.on_readings.each do |reading| %>
          <span class="pill light"><%= reading %></span>
        <% end %>
      </div>
    <% end %>
  </article>
</section>
